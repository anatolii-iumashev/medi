---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_PRACTICE, PRACTICES } from '../scripts/practices';

const base = import.meta.env.BASE_URL;
const themes = [
  { value: 'system', label: 'Системная' },
  { value: 'dark', label: 'Тёмная' },
  { value: 'light', label: 'Светлая' },
];
---

<BaseLayout title="Настройки — medi" description="Настройки medi: аудио по умолчанию и тема.">
  <main class="flex min-h-dvh flex-col items-center bg-base-100 px-5 py-6 text-base-content sm:px-8 sm:py-14">
    <div class="w-full max-w-md">
      <a
        href={base}
        class="inline-flex min-h-11 items-center gap-2 rounded-xl px-2 text-sm text-base-content/70 transition-colors hover:text-base-content"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
        На главную
      </a>

      <h1 class="mt-3 text-3xl font-semibold tracking-tight">Настройки</h1>
      <p class="mt-2 text-sm text-base-content/60">Всё хранится на этом устройстве.</p>

      <fieldset class="mt-6">
        <legend class="mb-2 text-sm font-medium">Аудио по умолчанию</legend>
        <div class="grid gap-2">
          {
            PRACTICES.map((practice) => (
              <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-2xl border border-base-content/15 px-4 py-2 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-base-100">
                <input
                  class="radio radio-primary radio-sm shrink-0"
                  type="radio"
                  name="default-practice"
                  value={practice.id}
                  checked={practice.id === DEFAULT_PRACTICE.id}
                  data-player-default-practice
                />
                <span class="text-sm font-medium">{practice.title}</span>
              </label>
            ))
          }
        </div>
        <p class="mt-2 text-xs text-base-content/60">Применится при следующем запуске.</p>
      </fieldset>

      <fieldset class="mt-6">
        <legend class="mb-2 text-sm font-medium">Тема</legend>
        <div class="grid gap-2">
          {
            themes.map((theme) => (
              <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-2xl border border-base-content/15 px-4 py-2 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-base-100">
                <input
                  class="radio radio-primary radio-sm shrink-0"
                  type="radio"
                  name="theme-preference"
                  value={theme.value}
                  checked={theme.value === 'dark'}
                  data-theme-preference
                />
                <span class="text-sm font-medium">{theme.label}</span>
              </label>
            ))
          }
        </div>
        <p class="mt-2 text-xs text-base-content/60">Тема применяется сразу.</p>
      </fieldset>
    </div>
  </main>

  <script>
    import { initPreferences } from '../scripts/preferences';
    initPreferences();
  </script>
</BaseLayout>
