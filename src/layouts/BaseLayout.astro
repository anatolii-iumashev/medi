---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru" data-theme="medi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#17231f" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('medi:theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const theme = stored === 'light' || (stored === 'system' && prefersLight) ? 'medi-light' : 'medi';
          document.documentElement.dataset.theme = theme;
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = theme === 'medi-light' ? '#f6f7f2' : '#17231f';
        } catch {
          document.documentElement.dataset.theme = 'medi';
        }
      })();
    </script>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <script src={`${base}registerSW.js`} defer></script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
