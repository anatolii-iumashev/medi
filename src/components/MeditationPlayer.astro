---
import { DEFAULT_PRACTICE, DEFAULT_SESSION_DURATION, PRACTICES } from '../scripts/practices';

const audioUrl = DEFAULT_PRACTICE.src;
const coverUrl = `${import.meta.env.BASE_URL}images/meditation-cover.svg`;
const sessionDurations = DEFAULT_PRACTICE.sessionDurations ?? [];
---

<section class="flex w-full max-w-md flex-col items-center text-center" aria-labelledby="app-title">
  <div class="aura aura-glow aura-sm mb-3 rounded-full text-primary sm:mb-6">
    <img
      class="block aspect-square w-20 rounded-full shadow-2xl shadow-black/20 sm:w-44"
      src={coverUrl}
      alt="Мягкие круги на спокойном тёмном фоне"
      width="176"
      height="176"
      fetchpriority="high"
    />
  </div>
  <h1 id="app-title" class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">medi</h1>

  <div class="mt-4 flex flex-col items-center gap-1 sm:mt-6">
    <p class="text-sm font-medium" data-player-current-title>{DEFAULT_PRACTICE.title}</p>
    <p class="text-xs text-base-content/60" data-player-current-description>{DEFAULT_PRACTICE.description}</p>
  </div>

  <div class="sr-only">
    <span class="status status-neutral" data-player-indicator aria-hidden="true"></span>
    <p role="status" aria-live="polite" data-player-status>Загружаем «{DEFAULT_PRACTICE.title}»…</p>
  </div>

  <audio src={audioUrl} preload="auto" loop data-player-audio hidden></audio>
</section>

<div
  class="dock dock-lg border-t border-base-content/10 bg-base-200 shadow-[0_-0.5rem_2rem_rgba(0,0,0,0.35)] sm:mx-auto sm:max-w-md"
  role="group"
  aria-label="Управление практикой"
>
  <div class="pointer-events-none mb-0 h-auto max-w-none flex-1" aria-hidden="true"></div>

  <div class="mb-0 flex h-auto w-16 max-w-none flex-none cursor-default flex-col items-center justify-center hover:opacity-100">
    <button
      class="flex min-h-11 w-full cursor-pointer flex-col items-center justify-center gap-0.5 text-primary"
      type="button"
      data-player-toggle
      aria-label="Начать"
    >
      <span
        class="flex size-8 items-center justify-center rounded-full bg-primary text-primary-content shadow-md shadow-primary/25 transition-transform"
      >
        <svg
          class="size-[1.2em]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          data-player-icon="play"
        >
          <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke="none"></path>
        </svg>
        <svg
          class="size-[1.2em]"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          data-player-icon="stop"
        >
          <rect x="6" y="6" width="12" height="12" rx="2"></rect>
        </svg>
      </span>
      <span class="dock-label whitespace-nowrap" data-player-toggle-label>Начать</span>
    </button>
  </div>

  <div class="mb-0 flex h-auto max-w-none flex-1 cursor-default flex-row items-center justify-end gap-1 hover:opacity-100">
    <details class="dropdown dropdown-top dropdown-end" data-player-dropdown="settings">
      <summary
        class="flex min-h-11 w-16 cursor-pointer list-none flex-col items-center justify-center gap-0.5 px-0.5 text-base-content/70"
        aria-label="Настройки"
      >
        <span class="flex size-8 items-center justify-center">
          <svg
            class="size-[1.2em]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
            ></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </span>
        <span class="dock-label whitespace-nowrap">Настройки</span>
      </summary>
      <div
        class="dropdown-content z-10 w-60 max-w-[calc(100vw-2rem)] rounded-box border border-base-content/10 bg-base-200 p-3 text-left shadow-2xl"
      >
        <fieldset data-player-durations>
          <legend class="mb-2 text-xs font-medium text-base-content/70">Длительность практики</legend>
          <div class="grid gap-1.5">
            {
              sessionDurations.map((minutes) => (
                <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-xl border border-base-content/15 px-3 py-2 text-xs transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-base-100">
                  <input
                    class="radio radio-primary radio-xs"
                    type="radio"
                    name="session-duration"
                    value={minutes}
                    checked={minutes === DEFAULT_SESSION_DURATION}
                    data-player-duration
                  />
                  <span>{minutes === 3 ? '3 минуты' : `${minutes} минут`}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <p class="text-xs text-base-content/70" data-player-duration-empty hidden>
          Для выбранной практики нет дополнительных настроек
        </p>
      </div>
    </details>

    <details class="dropdown dropdown-top dropdown-end" data-player-dropdown="sound">
      <summary
        class="flex min-h-11 w-16 cursor-pointer list-none flex-col items-center justify-center gap-0.5 px-0.5 text-base-content/70"
        aria-label={`Звук: ${DEFAULT_PRACTICE.title}`}
      >
        <span class="flex size-8 items-center justify-center">
          <svg
            class="size-[1.2em]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M11 5 6 9H2v6h4l5 4z"></path>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
          </svg>
        </span>
        <span class="dock-label whitespace-nowrap">Звук</span>
      </summary>
      <div
        class="dropdown-content z-10 w-64 max-w-[calc(100vw-2rem)] rounded-box border border-base-content/10 bg-base-200 p-3 text-left shadow-2xl"
      >
        <fieldset>
          <legend class="sr-only">Выберите практику</legend>
          <div class="grid gap-1.5">
            {
              PRACTICES.map((practice) => (
                <label class="flex min-h-11 cursor-pointer items-start gap-3 rounded-xl border border-base-content/15 px-3 py-2 text-left transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-base-100">
                  <input
                    class="radio radio-primary radio-sm mt-0.5 shrink-0"
                    type="radio"
                    name="practice"
                    value={practice.id}
                    checked={practice.id === DEFAULT_PRACTICE.id}
                    data-player-practice
                  />
                  <span class="flex flex-col gap-0.5">
                    <span class="text-sm font-medium">{practice.title}</span>
                    <span class="text-[10px] text-base-content/60">{practice.description}</span>
                    <span class="text-[10px] text-base-content/50">{practice.duration}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </div>
    </details>
  </div>
</div>

<script>
  import { initDropdowns } from '../scripts/dropdowns';
  import { initPlayer } from '../scripts/player';

  initDropdowns();
  initPlayer();
</script>
