---
const audioUrl = `${import.meta.env.BASE_URL}audio/meditation.mp3`;
const coverUrl = `${import.meta.env.BASE_URL}images/meditation-cover.svg`;
---

<section class="flex w-full max-w-md flex-col items-center text-center" aria-labelledby="practice-title">
  <img
    class="mb-8 aspect-square w-40 rounded-full shadow-2xl shadow-black/20 sm:w-48"
    src={coverUrl}
    alt="Мягкие круги на спокойном тёмном фоне"
    width="192"
    height="192"
    fetchpriority="high"
  />
  <p class="mb-3 text-xs font-semibold tracking-[0.22em] text-base-content/60 uppercase">6 минут · без сети</p>
  <h1 id="practice-title" class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Тихое дыхание</h1>
  <p class="mt-4 max-w-xs text-base leading-relaxed text-base-content/70">
    Непрерывный звук для спокойной практики. Ничего настраивать не нужно.
  </p>

  <div class="mt-8 flex min-h-6 items-center justify-center gap-2 text-sm text-base-content/80">
    <span class="status status-neutral" data-player-indicator aria-hidden="true"></span>
    <p role="status" aria-live="polite" data-player-status>Загружаем практику…</p>
  </div>

  <button
    class="btn btn-primary btn-lg mt-5 min-h-14 w-full max-w-xs text-base font-semibold"
    type="button"
    data-player-toggle
    aria-label="Начать"
  >Начать</button>
  <audio src={audioUrl} preload="auto" loop data-player-audio hidden></audio>
</section>

<script>
  import { initPlayer } from '../scripts/player';
  initPlayer();
</script>
